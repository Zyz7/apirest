-- Trigger para INSERT
CREATE TRIGGER insert_users
AFTER INSERT ON Users
FOR EACH ROW
BEGIN
    INSERT INTO Logs (action, tabla, description)
    VALUES ('insert', 'users', 'New line inserted with id: ' || NEW.id);
END;

-- Trigger para UPDATE
CREATE TRIGGER update_users
AFTER UPDATE ON Users
FOR EACH ROW
BEGIN
    INSERT INTO Logs (action, tabla, description)
    VALUES ('update', 'users', 'Line modified with id: ' || OLD.id);
END;

-- Trigger para DELETE
CREATE TRIGGER delete_suppliers
AFTER DELETE ON Suppliers
FOR EACH ROW
BEGIN
    INSERT INTO Logs (action, tabla, description)
    VALUES ('delete', 'suppliers', 'Line removed with id: ' || OLD.id);
END;

