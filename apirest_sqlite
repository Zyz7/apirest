-- Tabla Products
DROP TABLE IF EXISTS Products;
CREATE TABLE Products (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  description TEXT,
  amount INTEGER NOT NULL,
  price REAL NOT NULL,
  categoryId INTEGER,
  FOREIGN KEY (categoryId) REFERENCES Categories(id)
);

