-- Tabla Addresses
DROP TABLE IF EXISTS Addresses;
CREATE TABLE Addresses (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  street TEXT NOT NULL,
  num TEXT NOT NULL,
  colony TEXT NOT NULL,
  postalcode INTEGER NOT NULL,
  state TEXT NOT NULL,
  country TEXT NOT NULL
);

